{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Verification evidence record",
  "description": "One record per verification run, written by COMPL and the guided certification (SYS-REQ-028). Stored under validation/. Owner: COMPL. Behavior: docs/components/compliance.md.",
  "type": "object",
  "required": ["runId", "commit", "target", "command", "startedAt", "finishedAt", "exitStatus", "results", "counts", "versions"],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string" },
    "commit": { "type": "string", "description": "Source commit verified." },
    "target": { "enum": ["local", "cloudflare", "aws"] },
    "stage": { "type": "string" },
    "command": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "exitStatus": { "type": "integer" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "Acceptance criterion or scenario ID, e.g. KV-AC-003, E2E-004." },
          "status": { "enum": ["passed", "failed", "blocked", "skipped", "unrun"] },
          "detail": { "type": "string" }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["passed", "failed", "blocked", "skipped", "unrun"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "unrun": { "type": "integer", "minimum": 0 }
      }
    },
    "versions": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Exact framework and dependency versions; never secrets." },
    "leftovers": { "type": "array", "items": { "type": "string" }, "description": "Cloud resources the run could not remove." }
  }
}
