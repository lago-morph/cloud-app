{
  "name": "@lago-morph/prototype-framework",
  "version": "0.1.0",
  "description": "A small portable web-app framework: one app runs unchanged locally and on Cloudflare, with SQL, KV, files, configuration, secrets, logging and login behind one API.",
  "keywords": [
    "framework",
    "prototype",
    "cloudflare",
    "workers",
    "hono",
    "d1",
    "r2"
  ],
  "license": "MIT",
  "author": "Lagomorph Labs",
  "homepage": "https://github.com/lago-morph/cloud-app/tree/main/packages/framework#readme",
  "bugs": {
    "url": "https://github.com/lago-morph/cloud-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lago-morph/cloud-app.git",
    "directory": "packages/framework"
  },
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./targets/local": {
      "types": "./dist/targets/local/public.d.ts",
      "default": "./dist/targets/local/public.js"
    },
    "./targets/cloudflare": {
      "types": "./dist/targets/cloudflare/public.d.ts",
      "default": "./dist/targets/cloudflare/public.js"
    },
    "./provision": {
      "types": "./dist/provision/public.d.ts",
      "default": "./dist/provision/public.js"
    },
    "./check": {
      "types": "./dist/check/public.d.ts",
      "default": "./dist/check/public.js"
    }
  },
  "bin": {
    "prototype-framework": "./bin/prototype-framework.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test-support.*",
    "migrations"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@typescript-eslint/utils": "8.72.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "hono": "4.13.13",
    "sst": "4.17.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "undici": "7.29.1",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.149.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5"
  }
}
