{
  "name": "@lago-morph/prototype-framework",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./targets/local": {
      "types": "./dist/targets/local/public.d.ts",
      "default": "./dist/targets/local/public.js"
    },
    "./targets/cloudflare": {
      "types": "./dist/targets/cloudflare/public.d.ts",
      "default": "./dist/targets/cloudflare/public.js"
    },
    "./targets/aws": {
      "types": "./dist/targets/aws/public.d.ts",
      "default": "./dist/targets/aws/public.js"
    },
    "./provision": {
      "types": "./dist/provision/public.d.ts",
      "default": "./dist/provision/public.js"
    },
    "./check": {
      "types": "./dist/check/public.d.ts",
      "default": "./dist/check/public.js"
    }
  },
  "bin": {
    "prototype-framework": "./bin/prototype-framework.js"
  },
  "files": [
    "bin",
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1153.0",
    "@aws-sdk/client-iam": "3.1153.0",
    "@aws-sdk/client-lambda": "3.1153.0",
    "@aws-sdk/client-rds": "3.1153.0",
    "@aws-sdk/client-rds-data": "3.1153.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.1153.0",
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/client-secrets-manager": "3.1153.0",
    "@aws-sdk/client-ssm": "3.1153.0",
    "@aws-sdk/client-sts": "3.1153.0",
    "@electric-sql/pglite": "0.5.8",
    "@smithy/node-http-handler": "4.12.1",
    "@typescript-eslint/utils": "8.72.0",
    "aws4fetch": "1.0.20",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "sst": "4.17.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.149.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "1.64.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-sdk-client-mock": "4.1.0"
  }
}
