import { expect, it } from "vitest";
import { createTestApp } from "@lago-morph/prototype-framework/testing";
import app from "../src/app";

const post = (title: string): RequestInit => ({
  method: "POST",
  headers: { "content-type": "application/json" },
  body: JSON.stringify({ title }),
});

it("negative limit returns every item", async () => {
  const t = await createTestApp(app);
  try {
    expect((await t.request("/api/items", post("a"))).status).toBe(201);
    expect((await t.request("/api/items", post("b"))).status).toBe(201);
    const res = await t.request("/api/items?limit=-1");
    expect(res.status).toBe(200);
    expect(await res.json()).toHaveLength(2);
  } finally {
    await t.dispose();
  }
});
