import { asc, configString, defineApp, jsonBody, newId, now, queryParams, z } from "@lago-morph/prototype-framework";
import { items } from "./server/schema";

const newItem = z.object({ title: z.string().min(1) });

export const app = defineApp({
  name: "fixtureapp",
  config: { greeting: configString({ default: "hello" }) },
  secrets: [],
  tables: { items },
  routes: (api) => {
    api.get("/hello", (c) => c.json({ greeting: c.var.config.get("greeting") }));
    api.post("/items", jsonBody(newItem), async (c) => {
      const { title } = c.req.valid("json");
      const itemId = newId();
      await c.var.sql.insert(items).values({ id: itemId, title, createdAt: now() });
      return c.json({ id: itemId }, 201);
    });
    // Works on SQLite (LIMIT -1 means "no limit"); Postgres rejects a negative LIMIT.
    api.get("/items", queryParams(z.object({ limit: z.coerce.number().int() })), async (c) => {
      const rows = await c.var.sql
        .select({ id: items.id, title: items.title })
        .from(items)
        .orderBy(asc(items.createdAt), asc(items.id))
        .limit(c.req.valid("query").limit);
      return c.json(rows);
    });
    // Works on SQLite; Postgres requires ORDER BY expressions of SELECT DISTINCT to be selected.
    api.get("/titles", async (c) => {
      const rows = await c.var.sql
        .selectDistinct({ title: items.title })
        .from(items)
        .orderBy(asc(items.createdAt));
      return c.json(rows.map((r) => r.title));
    });
  },
});

export default app;
