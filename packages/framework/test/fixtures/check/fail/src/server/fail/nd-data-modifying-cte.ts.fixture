import { newId, now, type PortableDb } from "@lago-morph/prototype-framework";
import { posts } from "./tables";

export const query = (db: PortableDb, authorId: string) => {
  const inserted = db.$with("inserted").as(
    db.insert(posts).values({ id: newId(), authorId, title: "t", createdAt: now() }).returning({ id: posts.id }),
  );
  return db.with(inserted).select().from(inserted);
};
