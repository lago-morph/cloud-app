{
  // Spike only. Same strict settings as the framework (tsconfig.node.json). drizzle-orm is
  // mapped to the spike's copy so the framework sources and the aws-data-api driver share one
  // drizzle instance (the root copy cannot see @aws-sdk/client-rds-data).
  "extends": "../../../../tsconfig.node.json",
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "drizzle-orm": ["./node_modules/drizzle-orm"],
      "drizzle-orm/*": ["./node_modules/drizzle-orm/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "fixtures/**/*.ts"]
}
